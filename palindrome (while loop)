#include <stdio.h>

int main()
{
    int n, original, rev = 0, d;

    printf("Enter a number: ");
    scanf("%d", &n);

    original = n;

    while (n > 0)
    {
        d = n % 10;
        rev = (rev * 10) + d;
        n = n / 10;
    }

    if (rev == original)
    {
        printf("%d is a palindrome\n", original);
    }
    else
    {
        printf("%d is not a palindrome\n", original);
    }

    return 0;
}
