#include<stdio.h>
#include<stdbool.h>
int main()
{
      int p = 0;
      printf("Enter an integer:");
      scanf("%d", & p);
      
      if (p <= 1)
      {
          printf("%d is neither prime nor composit",p);
          return 0;
      }

     bool flag = true;

      for (int i = 2 ; i < p; i++)
      {
          if (p % i == 0)
          {
            flag=false;
            break;
          }
      }
          if (flag == true)
          {
          printf("%d is prime",p);
          }
          else
          {
          printf("%d is not prime",p);
          }
          return 0;
}

